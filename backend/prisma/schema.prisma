generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_OPERATOR
  BOULDER_OPERATOR
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum PaymentCategory {
  CASH
  ONLINE
  ACCOUNT
  CHEQUE
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(SALES_OPERATOR)
  status       UserStatus  @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  salesCreated        Sale[]               @relation("SaleCreatedBy")
  salesUpdated        Sale[]               @relation("SaleUpdatedBy")
  boulderTripsCreated BoulderTrip[]        @relation("BoulderTripCreatedBy")
  boulderTripsUpdated BoulderTrip[]        @relation("BoulderTripUpdatedBy")
  auditLogs           AuditLog[]

  @@map("app_users")
}

model RefreshSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Buyer {
  id        String   @id @default(uuid())
  name      String   @unique
  gstin     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("buyers")
}

model Vehicle {
  id            String   @id @default(uuid())
  vehicleNumber String   @unique
  tareWeight    Decimal? @db.Decimal(12, 3)
  driverName    String?
  driverPhone   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales        Sale[]
  boulderTrips BoulderTrip[]

  @@map("vehicles")
}

model Sale {
  id                 String          @id @default(uuid())
  serialNumber       String?
  transactionDate    DateTime
  buyerId            String?
  buyer              Buyer?          @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName          String
  gstin              String?
  vehicleId          String?
  vehicle            Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleNumber      String
  vehicleType        String?
  material           String
  grossWeight        Decimal         @db.Decimal(12, 3)
  grossDateTime      DateTime?
  tareWeight         Decimal         @db.Decimal(12, 3)
  tareDateTime       DateTime?
  netWeight          Decimal         @db.Decimal(12, 3)
  rate               Decimal         @db.Decimal(12, 2)
  amount             Decimal         @db.Decimal(12, 2)
  paymentCategory    PaymentCategory
  creditDebit        String?
  referenceNumber    String?
  remarks            String?
  isCancelled        Boolean         @default(false)
  cancellationReason String?
  createdById        String
  createdBy          User            @relation("SaleCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          User?           @relation("SaleUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([transactionDate])
  @@index([buyerId])
  @@index([paymentCategory])
  @@index([isCancelled])
  @@index([serialNumber])
  @@map("sales")
}

model BoulderTrip {
  id                 String    @id @default(uuid())
  tripDate           DateTime
  supplierOrOperator String
  vehicleId          String?
  vehicle            Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleNumber      String
  grossWeight        Decimal   @db.Decimal(12, 3)
  tareWeight         Decimal   @db.Decimal(12, 3)
  netWeight          Decimal   @db.Decimal(12, 3)
  driverName         String?
  remarks            String?
  isCancelled        Boolean   @default(false)
  cancellationReason String?
  createdById        String
  createdBy          User      @relation("BoulderTripCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          User?     @relation("BoulderTripUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tripDate])
  @@index([supplierOrOperator])
  @@index([isCancelled])
  @@map("boulder_trips")
}

model AuditLog {
  id         String   @id @default(uuid())
  timestamp  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  @@index([timestamp])
  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@map("audit_logs")
}
