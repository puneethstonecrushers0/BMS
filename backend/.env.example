# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (Direct local PostgreSQL connection string)
DATABASE_URL="postgresql://app_user:YOUR_PASSWORD@localhost:5432/boulder_business?schema=public"

# Security & Secrets (Minimum 32 characters for JWT secrets)
JWT_ACCESS_SECRET="bms_super_secret_access_jwt_key_min_32_characters"
JWT_REFRESH_SECRET="bms_super_secret_refresh_jwt_key_min_32_characters"

# CORS & Cookies
CORS_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# Redis Cache
REDIS_URL="redis://127.0.0.1:6379"

